{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunapot-panel",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "lunapot-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}]
}

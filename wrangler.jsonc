{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunapot-panel",
  "account_id": "46d9b05d5b69c0241e736ce869a0a642",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lunapot-db",
      "database_id": "d1def5dd-0aff-402a-af89-7d580b22daae",
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
